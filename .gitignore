# ===== Obsidian 会话状态（频繁变动，不应进 Git）=====
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/

# ===== Obsidian 回收站 =====
.trash/

# ===== obsidian-git 插件配置（禁用中，防误启用污染仓库）=====
.obsidian/plugins/obsidian-git/data.json

# ===== 本地备份与临时文件（不进 Git）=====
_moved_out/
.rslsync/
.DS_Store

# ===== 敏感配置 / 环境目录 =====
.claude/
.conda/

# ===== 测试残留 =====
rs-test-folder-*/

# ===== 教材 OCR 临时文本（体积大，仅留本地复查；仅索引 README 入库）=====
教材OCR/*
!教材OCR/README.md

# ===== 临时工作文件（一次性脚本/中间产物，用完即删）=====
temp_*

# ===== Python 虚拟环境与缓存 =====
.venv/
venv/
__pycache__/
*.pyc
